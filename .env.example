# Local development credentials only. Keep DATABASE_URL aligned with POSTGRES_*.
POSTGRES_DB=pl_analytics
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/pl_analytics
DATABASE_CONNECT_TIMEOUT=5
FOOTBALL_DATA_API_TOKEN=
# Comma-separated canonical competition codes. V1 intentionally uses only EPL.
# Future example: EPL,LALIGA,BUNDESLIGA,SERIE_A,LIGUE_1
ACTIVE_COMPETITIONS=EPL
DATA_DIR=data
ARTIFACT_DIR=artifacts
LOG_LEVEL=INFO
